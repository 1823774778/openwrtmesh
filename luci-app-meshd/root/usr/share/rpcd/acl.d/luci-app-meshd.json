{
	"luci-app-meshd": {
		"description": "Read Mesh status and manage node authorization and wireless transactions",
		"read": {
			"ubus": {
				"meshd": [
					"status", "topology", "link_quality", "client_list", "roam_config",
					"config_status", "diagnose", "upgrade_status", "event_log"
				]
			}
		},
		"write": {
			"ubus": {
				"meshd": [ "enroll", "remove_node", "config_apply", "config_rollback" ]
			}
		}
	}
}
