config mesh 'core'
	option enabled '0'
	option role 'candidate'
	option net_name 'HomeMesh'
	option bind_ip ''
	option broadcast_ip ''
	option gateway_ip ''
	option gateway_id ''
	option model 'OpenWrt'
	option management_vlan '4094'

config mesh 'roam'
	option enabled '1'
	option ft_mode 'simple'
	option k_neighbor '1'
	option k_beacon '1'
	option v_bss_transition '1'
	# list ap 'my_named_client_ap'

config mesh 'backhaul'
	option prefer 'auto'
	option protocol 'auto'

config mesh 'guest'
	option enabled '0'
	option isolate '1'

config mesh 'security'
	option mtls '1'
	option allow_wps '0'
